# EmailJS - https://dashboard.emailjs.com
# Used by the newsletter signup (src/lib/emailjs.ts).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=REPLACE_SERVICE_ID
NEXT_PUBLIC_EMAILJS_NEWSLETTER_TEMPLATE_ID=REPLACE_NEWSLETTER_TEMPLATE_ID
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=REPLACE_PUBLIC_KEY

# Sanity CMS - https://www.sanity.io/manage
# Project ID from the project page; dataset is usually "production".
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Any long random string. Paste the same value into the Sanity webhook (see SANITY_SETUP.md).
SANITY_REVALIDATE_SECRET=
